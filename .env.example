# .env.example — commit this file; copy it to .env and fill in values
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

AIKIT_PROVIDER=anthropic          # anthropic | openai | ollama
AIKIT_CHAT_MODEL=                 # e.g. your provider's current recommended model
AIKIT_FAST_MODEL=                 # a cheaper, faster model for simple tasks
AIKIT_EMBED_MODEL=                # embedding model (Chapter 8)
AIKIT_MAX_OUTPUT_TOKENS=1024
AIKIT_LOG_PROMPTS=false           # never true in production without approval
